# =====================================================================
# Copy to .env.local and fill in. Never commit .env.local.
#
# There is no Supabase in this system. PostgreSQL holds the data,
# PostgREST serves it, and auth and storage are route handlers in this
# app. @supabase/ssr survives only as the HTTP client that speaks
# PostgREST's dialect — it contacts nothing outside this deployment.
#
# Generate the JWT values first:
#   node Backend/postgrest/generate-secrets.mjs
# That writes Backend/postgrest/.env and prints the three keys below.
# =====================================================================

# The client resolves /rest/v1, /auth/v1 and /storage/v1 against this.
# Point it at the app itself: next.config.ts proxies /rest/v1 to PostgREST,
# and /auth/v1 + /storage/v1 are route handlers here.
#
# On Vercel this is optional — it defaults to the deployment's own URL.
NEXT_PUBLIC_API_URL=http://localhost:3000

# From Backend/postgrest/.env — ANON_KEY and SERVICE_ROLE_KEY.
# The anon key is safe in the browser; under the RLS policies it sees
# nothing without a valid token. The service-role key bypasses RLS
# entirely and must stay server-side (no NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_ANON_KEY=
SERVICE_ROLE_KEY=

# Signs and verifies access tokens. MUST match PGRST_JWT_SECRET, which
# start.ps1 reads from Backend/postgrest/.env — if they drift, every
# request 401s. Server-side only.
JWT_SECRET=
JWT_EXPIRY=3600

# Where next.config.ts proxies /rest/v1, and where the auth routes call
# their RPCs. PostgREST sits on 3010, clear of Next's 3000/3001 fallback.
# On Vercel this is optional — it defaults to the deployed PostgREST.
POSTGREST_URL=http://127.0.0.1:3010

# ---- Direct Postgres (migration and admin scripts only; not read by the app) ----
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/electrobtechoms
PGHOST=localhost
PGPORT=5432
PGDATABASE=electrobtechoms
PGUSER=postgres
PGPASSWORD=YOUR_PASSWORD

# Study material files live in MongoDB GridFS; everything else stays in
# storage_objects (see below).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=electrobtech_files

# =====================================================================
# Production (Vercel + Railway)
#
# Only the three secrets need setting in the Vercel dashboard:
#   NEXT_PUBLIC_ANON_KEY, SERVICE_ROLE_KEY, JWT_SECRET
#
# NEXT_PUBLIC_API_URL, POSTGREST_URL and JWT_EXPIRY all have working
# production defaults. Set NEXT_PUBLIC_API_URL explicitly once a custom
# domain is attached, since the browser must call the host it was served
# from.
#
# The old SUPABASE_* spellings still resolve, so an environment configured
# before the rename keeps working. See LEGACY_ALIASES in
# src/lib/api/env.ts, and DEPLOY.md for the full walkthrough.
# =====================================================================
